 .../assets/{index-EshRXSfr.js => index-Bt1tJwZI.js}       | 2 +-
 landing/public/index.html                                 | 2 +-
 landing/src/components/Contact.jsx                        | 8 ++++++++
 4 files changed, 16 insertions(+), 2 deletions(-)
 rename landing/public/assets/{index-EshRXSfr.js => index-Bt1tJwZI.js} (97%)

diff --git a/admin-server/src/lib/mailer.js b/admin-server/src/lib/mailer.js
index 77a7cbe..00c9161 100644
--- a/admin-server/src/lib/mailer.js
+++ b/admin-server/src/lib/mailer.js
@@ -14,6 +14,12 @@ function getTransporter() {
     transporter = nodemailer.createTransport({
       service: 'gmail',
       auth: { user: process.env.GMAIL_USER, pass: process.env.GMAIL_APP_PASSWORD },
+      // Sans ça, une connexion SMTP sortante bloquée par l'hébergeur (port
+      // filtré, paquets silencieusement ignorés) fait attendre l'appelant
+      // indéfiniment au lieu d'échouer proprement.
+      connectionTimeout: 10000,
+      greetingTimeout: 10000,
+      socketTimeout: 15000,
     });
   }
   return transporter;

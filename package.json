{
  "name": "fitnessmov-planning",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client",
    "admin-server",
    "admin-client",
    "landing",
    "talents-server",
    "talents-client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev:admin": "concurrently \"npm run dev --workspace=admin-server\" \"npm run dev --workspace=admin-client\"",
    "dev:landing": "npm run dev --workspace=landing",
    "dev:talents": "concurrently \"npm run dev --workspace=talents-server\" \"npm run dev --workspace=talents-client\"",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
